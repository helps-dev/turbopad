# TurboPad Server Environment Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Public Domain / Hostname for Nginx (e.g. turbopad.xyz or your server IP)
DOMAIN=localhost

# Optional: Custom RPC endpoint for Robinhood Chain (default uses public RPC)
# ROBINHOOD_RPC_URL=https://rpc.robinhood.com
