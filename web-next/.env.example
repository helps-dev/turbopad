# Copy to .env.local (git-ignored) and fill in. On Vercel, set these as
# Environment Variables in the project settings instead.

# Keyed JSON-RPC for Robinhood Chain mainnet. SERVER ONLY — no NEXT_PUBLIC_
# prefix, so Next.js will refuse to inline it into the browser bundle.
#
# Needed for holder-concentration analysis: the free public endpoints cap
# eth_getLogs at ~10 blocks, while alchemy_getAssetTransfers accepts the full
# range with paging. Measured on live tokens: 6 requests / 9 s for a small
# token, 60 requests / 76 s for a busy one — so this runs server-side and
# cached, never per visitor.
TURBOPAD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Optional: same for testnet (chain 46630).
# TURBOPAD_RPC_URL_TESTNET=

# Official TURBO contract address once it launches. Public by nature — it ends
# up in the browser, which is fine for a contract address.
# NEXT_PUBLIC_TURBOPAD_FEATURED_ADDRESS=
