{
  "name": "turbopad-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TurboPad on Next.js — terminal & launchpad on Robinhood Chain. Server side keeps RPC keys out of the browser.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/",
    "test:unit": "node --test --experimental-strip-types test/unit.test.ts",
    "test:live": "node --test --experimental-strip-types test/live.test.ts",
    "verify": "npm run typecheck && npm run test:unit && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
